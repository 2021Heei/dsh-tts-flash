{
  "name": "dsh-tts-flash",
  "description": "DSH voice reader: read LLM replies aloud as they stream. Edge-tts built-in, any OpenAI-compatible cloud TTS plugs in via the settings panel, plus a voiced waiting-phrase ticker while the model thinks.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/segmenter.test.mjs && node test/settings-store.test.mjs && node --experimental-strip-types test/thinking-queue.test.mjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "msedge-tts": "^2.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT"
}
